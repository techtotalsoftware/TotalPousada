//.ENV


# Configuração do Servidor
PORT=

# Configuração da Base de Dados
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Segredo para JWT de usuários comuns
JWT_SECRET=
PROVISION_WEBHOOK_SECRET=
# Ambiente
NODE_ENV=

# Tenant usado pela rota publica de quartos quando nao ha correspondencia
# explicita (opcional).
PUBLIC_ROOMS_TENANT_ID=

# SMTP para e-mails transacionais (confirmacao de reserva, lembrete de
# check-in). Se nao preenchido, o envio de e-mail e apenas pulado com um
# aviso no log — nao quebra a criacao de reserva.
SMTP_HOST=
SMTP_PORT=
# "true" para conexao TLS direta (porta 465); deixe vazio/"false" para STARTTLS (porta 587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Endereco que aparece como remetente (ex.: "Total Pousada <no-reply@seudominio.com>")
MAIL_FROM=

# Segredo do job de cron que envia o lembrete de check-in diário
# (POST /api/cron/checkin-reminders, mesmo padrao do PROVISION_WEBHOOK_SECRET).
CRON_SECRET=
